# Pin a verified image to an immutable digest from the Web workflow.
VALIO_WEB_IMAGE=ghcr.io/valio-projects/valio-web@sha256:REPLACE_WITH_DIGEST
VALIO_BIND_ADDRESS=127.0.0.1
VALIO_WEB_PORT=18080
VALIO_ALLOWED_HOSTS=localhost
# Exact peer IP of the TLS reverse proxy as seen by the web container.
# For a host proxy, inspect the Compose network's gateway address.
VALIO_TRUSTED_PROXY=
VALIO_WEB_CPUS=2
VALIO_WEB_MEMORY=1g
